{
  "expo": {
    "name": "BangunPaksa",
    "slug": "bangunpaksa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.naufalputra.bangunpaksa",
      "infoPlist": {
        "UIBackgroundModes": ["audio", "location", "fetch", "processing"],
        "NSMicrophoneUsageDescription": "Aplikasi memerlukan akses mikrofon untuk rekaman suara kustom alarm",
        "NSCameraUsageDescription": "Aplikasi memerlukan akses kamera untuk misi scan barcode dan foto objek",
        "NSPhotoLibraryUsageDescription": "Aplikasi memerlukan akses galeri untuk memilih foto referensi misi",
        "NSMotionUsageDescription": "Aplikasi memerlukan akses sensor gerak untuk misi shake dan squat",
        "NSLocationWhenInUseUsageDescription": "Aplikasi memerlukan lokasi untuk fitur cuaca di TTS briefing"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.naufalputra.bangunpaksa",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_SYSTEM_ALERT_WINDOW",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.DISABLE_KEYGUARD",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.VIBRATE",
        "android.permission.FLASHLIGHT",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.BODY_SENSORS",
        "android.permission.HIGH_SAMPLING_RATE_SENSORS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "intentFilters": [
        {
          "action": "android.intent.action.BOOT_COMPLETED",
          "category": "android.intent.category.DEFAULT"
        },
        {
          "action": "android.intent.action.LOCKED_BOOT_COMPLETED",
          "category": "android.intent.category.DEFAULT"
        }
      ]
    },
    "plugins": [
      "expo-camera",
      "expo-barcode-scanner",
      "expo-av",
      "expo-notifications",
      "expo-sensors",
      "expo-secure-store",
      "expo-task-manager",
      "expo-background-fetch",
      "expo-image-picker",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 37,
            "targetSdkVersion": 36,
            "minSdkVersion": 26,
            "extraMavenRepos": ["https://maven.google.com"],
            "enableProguardInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}